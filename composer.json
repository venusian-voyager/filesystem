        "league/flysystem": "^3.25.1",
        "league/flysystem-local": "^3.25.1",
        "symfony/filesystem": "^v8.0.0",
        "symfony/finder": "^8.0",
        "symfony/mime": "^v8.0.0",
        "venusian-voyager/collections": "^0.9.0",
